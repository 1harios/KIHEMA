# --- TMDB (каталог и метаданные) ---
# Достаточно одного из двух. Read Access Token предпочтительнее: он уходит
# заголовком, а не в URL, и работает и для v3, и для v4.
# Оба берутся здесь: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_READ_TOKEN=

# Язык и регион каталога. Регион влияет на возрастной рейтинг, даты релиза
# и список стримингов.
TMDB_LANGUAGE=ru-RU
TMDB_REGION=RU

# --- Jellyfin (воспроизведение) ---
# Например http://192.168.1.10:8096 (без слэша на конце)
JELLYFIN_URL=
# Имя клиента, которое будет видно в Dashboard -> Devices
JELLYFIN_CLIENT_NAME=Kinema
# Админский API-ключ: нужен ТОЛЬКО для фоновой сборки индекса TMDB->Jellyfin.
# Dashboard -> API Keys. Пользователи логинятся своими учётками, не этим ключом.
JELLYFIN_API_KEY=

# --- Прочее ---
# Секрет для подписи cookie сессии
SESSION_SECRET=change-me
# Демо-режим: работает без Jellyfin и TMDB на встроенных данных
DEMO_MODE=true

# --- Кнопка «Пропустить заставку» ---
# Публичные таймкоды TheIntroDB по TMDB ID. Для чтения ключ не требуется.
INTRODB_ENABLED=true
INTRODB_API_URL=https://api.theintrodb.org
# Необязательно: нужен прежде всего для отправки собственных таймкодов.
INTRODB_API_KEY=

# --- Внешние CDN-источники ---
# Выключены по умолчанию. Проекту для воспроизведения достаточно Jellyfin
# (своя медиатека) и встроенного архива общественного достояния.
# Собственного прокси потоков в проекте нет: источники, не разрешающие прямое
# обращение из браузера, играться не будут.
SCRAPERS_ENABLED=false
